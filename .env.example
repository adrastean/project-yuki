# Optional provider settings. The prototype works in demo mode without these.
# Gemini API free-tier option. If GEMINI_API_KEY exists, Yuki prefers Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Free local Windows voice. Leave SAPI_VOICE empty to auto-pick a female installed voice.
TTS_PROVIDER=browser
SAPI_VOICE=

# Optional Piper voice (fully local, no API key). The .whl is installed with pip; the .onnx is not opened.
# Set TTS_PROVIDER=piper after installing Piper and a voice model.
# PIPER_PYTHON=py
# PIPER_PYTHON_VERSION=3.14
# PIPER_EXECUTABLE=tools/piper/piper.exe
# PIPER_MODEL=tools/piper/voices/en_US-lessac-medium.onnx

# OpenAI-compatible API (OpenAI, LM Studio, OpenRouter, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
YUKI_MODEL=gpt-4o-mini

# Free online neural voice provider (no API key; uses Microsoft's Edge voice service).
# Set EDGE_TTS_PYTHON to a Python installation where `edge-tts` is installed.
TTS_PROVIDER=edge
EDGE_TTS_PYTHON=python
EDGE_TTS_VOICE=en-US-JennyNeural
EDGE_TTS_RATE=+5%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_TIMEOUT_MS=30000

# Local Qwen3-TTS voice cloning. Install dependencies in its own Python venv.
# The reference audio is the voice-designed sample saved from the Qwen demo.
# Set TTS_PROVIDER=qwen only after the model has been installed and tested.
# QWEN_TTS_PYTHON=tools/qwen-tts/venv/Scripts/python.exe
# QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
# QWEN_TTS_REFERENCE_WAV=tools/qwen-tts/voices/yuki-design-reference.wav
# QWEN_TTS_REFERENCE_TEXT=It's in the top drawer... wait, it's empty? No way, that's impossible! I'm sure I put it there!
# QWEN_TTS_STARTUP_TIMEOUT_MS=600000
# QWEN_TTS_TIMEOUT_MS=120000

# Optional realistic voice provider. Keep these only in your local .env file.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Or use a local Ollama server instead.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b

# Optional local Turkish QLoRA test (requires training/.venv and the downloaded Qwen2.5-3B model).
# Set YUKI_PROVIDER=qlora to try the adapter; set it to ollama to return to the normal Ollama model.
# YUKI_PROVIDER=ollama
# YUKI_QLORA_PYTHON=training/.venv/Scripts/python.exe
# YUKI_QLORA_STARTUP_TIMEOUT_MS=180000
# YUKI_QLORA_TIMEOUT_MS=120000

PORT=3030

# Optional local GPU English speech input for the Electron app.
STT_PROVIDER=whisper
STT_PYTHON=tools/edge-tts/venv/Scripts/python.exe
VOSK_PYTHON=python
STT_MODEL=small.en
STT_MODEL_DIR=tools/whisper/models
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_TIMEOUT_MS=30000
STT_SILENCE_MS=1800
STT_ENERGY_THRESHOLD=80
